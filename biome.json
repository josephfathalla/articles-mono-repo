{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!bts.jsonc",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.alchemy",
      "!**/.svelte-kit",
      "!**/wrangler.jsonc",
      "!**/.source",
      "!**/apps/server",
      "!**/packages/api",
      "!**/apps/website/src/routeTree.gen.ts"
    ]
  },
  "overrides": [
    {
      "includes": [
        "apps/backend/src/**/*.service.ts",
        "apps/backend/src/**/*.controller.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.spec.ts", "**/*.test.ts", "**/test/**/*.ts"],
      "javascript": {
        "globals": [
          "jest",
          "describe",
          "it",
          "expect",
          "beforeEach",
          "afterEach",
          "beforeAll",
          "afterAll",
          "test"
        ]
      }
    },
    {
      "includes": [
        "**/Header.tsx",
        "**/ArticleForm.tsx",
        "**/ArticlesList.tsx",
        "**/CategoryForm.tsx",
        "apps/website/src/routes/**/*.tsx",
        "packages/contracts/src/interfaces/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ],
  "extends": ["ultracite/core", "ultracite/react"]
}
